@page "/profile"
@attribute [Authorize]
@inject IProfileService ProfileService

<PageTitle>Профил</PageTitle>

<div class="sc-narrow">
    <h1 class="h3 mb-3">Моят профил</h1>

    @if (loadFailed)
    {
        <div class="alert alert-warning">Профилът не може да се зареди. Проверете връзката и опитайте отново.</div>
    }
    else if (profile is null)
    {
        <p class="text-body-secondary">Зареждане...</p>
    }
    else
    {
        <ProfileCard Profile="profile" />
        <div class="sc-actions">
            @if (profile.Roles.Contains("Customer"))
            {
                <a class="btn btn-primary" href="card">Моята карта</a>
            }

            @if (profile.Roles.Contains("Barista") || profile.Roles.Contains("Admin"))
            {
                <a class="btn btn-primary" href="barista">Сканиране</a>
            }
        </div>
    }
</div>

@code {
    private ProfileDto? profile;
    private bool loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await ProfileService.GetCurrentAsync();
            loadFailed = profile is null;
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
    }
}
