@inherits LayoutComponentBase

<header class="navbar sc-navbar sc-app-header px-3">
    <span class="navbar-brand">
        <Logo Variant="LogoVariant.SecondaryWhite" Height="40" />
    </span>
</header>

<main class="container content">
    @Body
</main>

<AuthorizeView>
    <nav class="sc-tabbar" aria-label="Основна навигация">
        <AuthorizeView Roles="Customer" Context="customer">
            <NavLink class="sc-tab" href="card">Карта</NavLink>
        </AuthorizeView>
        <AuthorizeView Roles="Barista,Admin" Context="staff">
            <NavLink class="sc-tab" href="barista">Сканирай</NavLink>
        </AuthorizeView>
        <NavLink class="sc-tab" href="profile">Профил</NavLink>
        <NavLink class="sc-tab" href="settings">Настройки</NavLink>
    </nav>
</AuthorizeView>
