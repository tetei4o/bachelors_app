{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "https://localhost:7060/"
  },
  "Jwt": {
    "Issuer": "StoryCups",
    "Audience": "StoryCups.Mobile",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "FromAddress": "no-reply@example.com",
    "FromName": "Story Cups"
  },
  "Qr": {
    "ActiveKeyId": 1,
    "Keys": [
      {
        "Id": 1
      }
    ],
    "TokenLifetime": "00:01:00",
    "RefreshBeforeExpiry": "00:00:20",
    "ScanSessionLifetime": "00:02:00"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "QrTokensPerMinute": 20,
    "ScansPerMinute": 60,
    "ActionsPerMinute": 120
  }
}
