{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "https://localhost:7060/"
  },
  "Jwt": {
    "Issuer": "StoryCups",
    "Audience": "StoryCups.Mobile",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "FromAddress": "no-reply@example.com",
    "FromName": "Story Cups"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  }
}
