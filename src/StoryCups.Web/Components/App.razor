<!DOCTYPE html>
<html lang="bg">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/StoryCups.Shared/lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/StoryCups.Shared/app.css"]" />
    <link rel="stylesheet" href="@Assets["StoryCups.Web.styles.css"]" />
    <ImportMap />
    <meta name="theme-color" content="#1E2124" />
    <link rel="icon" type="image/svg+xml" href="@Assets["_content/StoryCups.Shared/logo.svg"]" />
    <link rel="icon" type="image/png" href="@Assets["_content/StoryCups.Shared/favicon.png"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="sc-site">
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Страниците за акаунта са статичен SSR (формите поставят бисквитка), останалите са интерактивни.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
