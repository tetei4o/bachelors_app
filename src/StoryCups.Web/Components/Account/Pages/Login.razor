@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using StoryCups.Application.Auth
@using StoryCups.Contracts.Auth
@using StoryCups.Infrastructure.Identity

@inject IAuthService AuthService
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Вход</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Вход</h1>
        <StatusMessage Message="@errorMessage" />
        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email" class="form-label">Имейл</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="парола" />
                <label for="Input.Password" class="form-label">Парола</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Input.RememberMe" id="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                <label for="Input.RememberMe" class="form-check-label">Запомни ме на това устройство</label>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Вход</button>
        </EditForm>
        <div class="mt-3">
            <p class="mb-1"><a href="Account/ForgotPassword">Забравена парола</a></p>
            <p class="mb-1">
                <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Нов акаунт</a>
            </p>
            <p class="mb-1"><a href="Account/ResendEmailConfirmation">Ново писмо за потвърждение</a></p>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Чисто начало: махаме евентуална външна бисквитка.
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        // Същата проверка като при мобилното приложение: броене на грешни опити и заключване (ADR-004).
        var check = await AuthService.CheckCredentialsAsync(new LoginRequest { Email = Input.Email, Password = Input.Password });
        if (!check.IsSuccess)
        {
            if (check.Error!.Code == AuthErrorCodes.LockedOut)
            {
                Logger.LogWarning("Опит за вход в заключен акаунт.");
                RedirectManager.RedirectTo("Account/Lockout");
                return;
            }

            errorMessage = $"{StatusMessage.ErrorPrefix} {check.Error.Message}";
            return;
        }

        var user = await UserManager.FindByIdAsync(check.Value.ToString());
        if (user is null)
        {
            errorMessage = $"{StatusMessage.ErrorPrefix} Грешен имейл или парола.";
            return;
        }

        await SignInManager.SignInAsync(user, Input.RememberMe, authenticationMethod: "pwd");
        Logger.LogInformation("Вход в сайта.");
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Имейлът е задължителен.")]
        [EmailAddress(ErrorMessage = "Невалиден имейл.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Паролата е задължителна.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
