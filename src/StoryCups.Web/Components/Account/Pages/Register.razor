@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using StoryCups.Application.Auth
@using StoryCups.Contracts.Auth

@inject IAuthService AuthService
@inject IdentityRedirectManager RedirectManager

<PageTitle>Регистрация</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Нов акаунт</h1>
        <StatusMessage Message="@errorMessage" />
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.DisplayName" id="Input.DisplayName" class="form-control" autocomplete="nickname" aria-required="true" placeholder="Име" />
                <label for="Input.DisplayName">Име за показване</label>
                <ValidationMessage For="() => Input.DisplayName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email">Имейл</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="password-help" placeholder="парола" />
                <label for="Input.Password">Парола</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
                <div id="password-help" class="form-text">Поне 10 символа. Може да е фраза от няколко думи.</div>
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="парола" />
                <label for="Input.ConfirmPassword">Повторете паролата</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Input.AcceptPrivacyPolicy" id="Input.AcceptPrivacyPolicy" class="darker-border-checkbox form-check-input" />
                <label for="Input.AcceptPrivacyPolicy" class="form-check-label">
                    Приемам <a href="privacy" target="_blank">политиката за поверителност</a>
                </label>
                <ValidationMessage For="() => Input.AcceptPrivacyPolicy" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Регистрация</button>
        </EditForm>
        <p class="mt-3">Имате акаунт? <a href="Account/Login">Вход</a></p>
    </div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    public async Task RegisterUser()
    {
        var result = await AuthService.RegisterAsync(new RegisterRequest
        {
            Email = Input.Email,
            Password = Input.Password,
            DisplayName = Input.DisplayName,
            AcceptPrivacyPolicy = Input.AcceptPrivacyPolicy,
        });

        if (!result.IsSuccess)
        {
            errorMessage = $"{StatusMessage.ErrorPrefix} {result.Error!.Message}";
            return;
        }

        RedirectManager.RedirectTo(
            "Account/RegisterConfirmation",
            new() { ["email"] = result.Value!.Email, ["returnUrl"] = ReturnUrl });
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Името е задължително.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Името трябва да е между {2} и {1} символа.")]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessage = "Имейлът е задължителен.")]
        [EmailAddress(ErrorMessage = "Невалиден имейл.")]
        [MaxLength(256)]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Паролата е задължителна.")]
        [StringLength(128, MinimumLength = 10, ErrorMessage = "Паролата трябва да е между {2} и {1} символа.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Паролите не съвпадат.")]
        public string ConfirmPassword { get; set; } = "";

        [Range(typeof(bool), "true", "true", ErrorMessage = "Нужно е съгласие с политиката за поверителност.")]
        public bool AcceptPrivacyPolicy { get; set; }
    }
}
